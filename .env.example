# Copy to .env and fill in. Never commit .env.

# Your Anthropic API key (console.anthropic.com). Every question costs a few cents.
ANTHROPIC_API_KEY=

# Optional. The model and effort the agent uses (defaults shown).
PPR_ASK_MODEL=claude-opus-5-5
PPR_ASK_EFFORT=medium

# Optional. Where the DuckDB database is built and read.
PPR_ASK_DB=data/ppr.duckdb
